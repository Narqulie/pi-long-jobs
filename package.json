{
  "name": "pi-long-jobs",
  "version": "0.3.0",
  "description": "Supervised long-running shell jobs with pi-subagents FleetView integration",
  "type": "module",
  "private": true,
  "files": [
    "src",
    "README.md",
    "config.example.json"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^24.10.10",
    "tsx": "^4.20.6",
    "typebox": "1.1.38",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
